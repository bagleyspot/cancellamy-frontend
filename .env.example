# Base URL of the Cancellamy API. In dev the Vite server proxies /api to http://localhost:3000.
VITE_API_BASE_URL=/api/v1
# Dev proxy target (read by vite.config.ts, not exposed to the browser). Default http://localhost:3000.
# VITE_PROXY_TARGET=http://localhost:3010
# Repository serving the running code (AGPL-3.0 section 13). Shown in the footer.
# VITE_SOURCE_URL=https://github.com/<you>/cancellamy
